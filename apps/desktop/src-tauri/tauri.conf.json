{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WA Desk",
  "version": "0.2.0-rc.6",
  "identifier": "io.github.dirttw.wadesk",
  "build": {
    "frontendDist": "../ui"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDMjVDNEMwMzU0M0MxQTgKUldTb3dVTTF3TVFscktqOXpEdDl6R1JXa3d2S1ZtVjFUMWI1S0V6dTNlU2xOYTZSTjJtYWRYVmoK",
      "endpoints": [
        "https://raw.githubusercontent.com/dirtTW/wa-desk/latest/latest.json",
        "https://github.com/dirtTW/wa-desk/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WA Desk",
        "width": 1120,
        "height": 780,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'; img-src 'self' data: blob: asset: http://asset.localhost https:; media-src 'self' data: blob: asset: http://asset.localhost https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "SocialNetworking",
    "publisher": "dirttw",
    "copyright": "Copyright (C) 2026 dirttw. Licensed under AGPL-3.0-only.",
    "shortDescription": "Unofficial WhatsApp desktop client",
    "longDescription": "A native WhatsApp client built on the unofficial whatsapp-rust protocol library. Not affiliated with WhatsApp or Meta.",
    "resources": {
      "../../../LICENSE.md": "LICENSE.md"
    },
    "windows": {
      "wix": {
        "version": "0.2.0.6"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
