{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WA Desk",
  "version": "0.1.0-rc.3",
  "identifier": "io.github.dirttw.wadesk",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WA Desk",
        "width": 1120,
        "height": 780,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "publisher": "dirttw",
    "copyright": "Copyright (C) 2026 dirttw. Licensed under AGPL-3.0-only.",
    "shortDescription": "Unofficial WhatsApp desktop client",
    "longDescription": "A native WhatsApp client built on the unofficial whatsapp-rust protocol library. Not affiliated with WhatsApp or Meta.",
    "resources": {
      "../../../LICENSE.md": "LICENSE.md"
    },
    "windows": {
      "wix": {
        "version": "0.1.0.3"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
